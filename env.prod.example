# Copiar a .env EN EL VPS (nunca commitear el .env real)

DOMAIN=finsight.jbyanx.dev

# --- PostgreSQL ---
DB_NAME=finsight
DB_USERNAME=finsight
DB_PASSWORD=            # generar: openssl rand -base64 24

# --- MongoDB ---
MONGODB_USERNAME=finsight
MONGODB_PASSWORD=       # generar
MONGODB_DATABASE=finsight

# --- JWT ---
JWT_SECRET=             # NUEVO, no reusar el de desarrollo: openssl rand -base64 32
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# --- Google OAuth ---
# Agregar en Google Cloud Console la redirect URI:
#   https://finsight.jbyanx.dev/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram ---
# Bot NUEVO de BotFather: dos instancias con el mismo token se roban los mensajes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Gemini ---
GEMINI_API_KEY=

# --- Scheduler ---
SCHEDULER_TOKEN_CLEANUP_CRON=0 0 0 * * *
