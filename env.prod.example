# =====================================================================
# DESARROLLO LOCAL — todo apunta a los contenedores de docker-compose.yml
#
# Este archivo NO debe tener credenciales de producción. Si necesitás
# reproducir un problema de producción, usá backend/.env.prod en su lugar.
#
# Levantar las bases:  docker compose up -d
# =====================================================================

SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL (contenedor local) ---
# El puerto es 5433 porque docker-compose mapea 5433:5432 para no chocar
# con un Postgres instalado en el sistema.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=finsight
DB_USERNAME=finsight_user
DB_PASSWORD=finsight_local_pass

# --- MongoDB (contenedor local) ---
# USERNAME y PASSWORD los usa docker-compose para inicializar el contenedor;
# MONGODB_URI los repite porque es lo que lee la aplicación.
MONGODB_USERNAME=finsight_user
MONGODB_PASSWORD=finsight_local_pass
MONGODB_URI=mongodb://finsight_user:finsight_local_pass@localhost:27017/finsight?authSource=admin

# --- Redis (contenedor local) ---
# Sin contraseña ni TLS: el contenedor local no los usa. En producción sí.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# Secreto de juguete. NUNCA reutilizar el de producción aquí.
JWT_SECRET=dev-secret-key-solo-para-local-minimo-256-bits-de-largo
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# --- Google OAuth2 ---
# Mismo cliente que producción, pero con la redirect URI de localhost
# registrada en Google Cloud Console:
#   http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram ---
# BOT DISTINTO al de producción. Dos instancias con el mismo token hacen
# long polling a la vez y se roban los mensajes entre sí.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Gemini ---
GEMINI_API_KEY=

# --- URLs ---
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# --- Scheduler ---
SCHEDULER_TOKEN_CLEANUP_CRON=0 0 0 * * *
