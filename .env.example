# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=finsight
DB_USERNAME=postrges
DB_PASSWORD=admin

# MongoDB
MONGODB_URI=mongodb://localhost:27017/finsight
MONGODB_USERNAME=mongoadmin
MONGODB_PASSWORD=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Google OAuth2
GOOGLE_CLIENT_ID=00000-clientId.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CLIENT-SECRET

# JWT
JWT_SECRET=your-256-bit-secret-key-here-make-it-long-enough
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

#Scheduler
SCHEDULER_TOKEN_CLEANUP_CRON=0 0 0 * * *

